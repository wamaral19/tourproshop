# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next.bak*
/.next.old*
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cloudflare / opennext
.open-next
.wrangler
.dev.vars
.dev.vars.*
cloudflare-env.d.ts

# preview passwords — plaintext in, hashes out; neither belongs in git.
# Globbed rather than named exactly: file sync leaves "… 2.sql" copies behind,
# and one of those slipping into a commit is the whole failure mode.
preview-passwords*.csv
preview-passwords*.sql

# generated at build time
/lib/site-mode.generated.ts
/lib/player-image-map.generated.ts
/lib/media-map.generated.ts
/public/media/

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code (local, machine-specific)
/.claude/
